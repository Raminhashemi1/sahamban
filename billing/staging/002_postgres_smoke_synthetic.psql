-- ISOLATED CI SMOKE TEST: disposable PostgreSQL only; never production.
\set ON_ERROR_STOP on
\i billing/staging/001_sahmino_billing_staging.sql
INSERT INTO sahmino_billing_staging.account_lock(account_id) VALUES
 ('00000000-0000-4000-8000-000000000001'),
 ('00000000-0000-4000-8000-000000000002');
INSERT INTO sahmino_billing_staging.purchase
 (id,channel,provider_purchase_id,account_id,plan_days,state,verified_at,effective_at,evidence_reference)
VALUES
 ('10000000-0000-4000-8000-000000000001','CAFEBAZAAR','synthetic-p1',
  '00000000-0000-4000-8000-000000000001',30,'VERIFIED',
  '2026-11-15T00:00:00Z','2026-11-15T00:00:00Z','FAKE_PROVIDER_EVIDENCE_ONLY');
DO $tests$
DECLARE failures int:=0;
BEGIN
 -- Duplicate receipt in the same store must fail. Subtransactions avoid side effects.
 BEGIN
  INSERT INTO sahmino_billing_staging.purchase
   (id,channel,provider_purchase_id,account_id,plan_days,state,verified_at,effective_at,evidence_reference)
  VALUES ('10000000-0000-4000-8000-000000000002','CAFEBAZAAR','synthetic-p1',
  '00000000-0000-4000-8000-000000000002',60,'VERIFIED',now(),now(),'FAKE');
  failures:=failures+1;
 EXCEPTION WHEN unique_violation THEN NULL;
 END;
 -- No unauthorized plan.
 BEGIN
  INSERT INTO sahmino_billing_staging.purchase
   (id,channel,provider_purchase_id,account_id,plan_days,state,verified_at,effective_at,evidence_reference)
  VALUES ('10000000-0000-4000-8000-000000000003','MYKET','synthetic-p2',
  '00000000-0000-4000-8000-000000000001',270,'VERIFIED',now(),now(),'FAKE');
  failures:=failures+1;
 EXCEPTION WHEN check_violation THEN NULL;
 END;
 -- No unknown payment provider.
 BEGIN
  INSERT INTO sahmino_billing_staging.purchase
   (id,channel,provider_purchase_id,account_id,plan_days,state,verified_at,effective_at,evidence_reference)
  VALUES ('10000000-0000-4000-8000-000000000004','UNKNOWN','synthetic-p3',
  '00000000-0000-4000-8000-000000000001',30,'VERIFIED',now(),now(),'FAKE');
  failures:=failures+1;
 EXCEPTION WHEN check_violation THEN NULL;
 END;
 -- Refunded without an invalidation timestamp must fail.
 BEGIN
  UPDATE sahmino_billing_staging.purchase SET state='REFUNDED'
  WHERE provider_purchase_id='synthetic-p1';
  failures:=failures+1;
 EXCEPTION WHEN check_violation THEN NULL;
 END;
 IF failures<>0 THEN RAISE EXCEPTION 'STAGING_CONSTRAINT_REGRESSION count=%',failures; END IF;
 IF (SELECT count(*) FROM sahmino_billing_staging.purchase)<>1 THEN
  RAISE EXCEPTION 'STAGING_UNEXPECTED_PURCHASE_COUNT';
 END IF;
END
$tests$;
-- Same synthetic receipt ID in a different channel has independent uniqueness scope.
INSERT INTO sahmino_billing_staging.purchase
 (id,channel,provider_purchase_id,account_id,plan_days,state,verified_at,effective_at,evidence_reference)
VALUES
 ('10000000-0000-4000-8000-000000000005','MYKET','synthetic-p1',
  '00000000-0000-4000-8000-000000000001',60,'VERIFIED',
  '2026-11-15T00:00:00Z','2026-11-15T00:00:00Z','FAKE_PROVIDER_EVIDENCE_ONLY');
INSERT INTO sahmino_billing_staging.audit_event
 (id,purchase_id,event_type,evidence_reference)
VALUES ('20000000-0000-4000-8000-000000000001',
 '10000000-0000-4000-8000-000000000001','VERIFIED','FAKE');
INSERT INTO sahmino_billing_staging.outbox
 (id,purchase_id,action)
VALUES ('30000000-0000-4000-8000-000000000001',
 '10000000-0000-4000-8000-000000000001','CONSUME');
-- Transaction rollback must remove all rows inserted inside it.
BEGIN;
INSERT INTO sahmino_billing_staging.purchase
 (id,channel,provider_purchase_id,account_id,plan_days,state,verified_at,effective_at,evidence_reference)
VALUES
 ('10000000-0000-4000-8000-000000000006','WEB_DIRECT','synthetic-rollback',
  '00000000-0000-4000-8000-000000000002',365,'VERIFIED',now(),now(),'FAKE');
ROLLBACK;
DO $verify$
BEGIN
 IF EXISTS (SELECT 1 FROM sahmino_billing_staging.purchase
            WHERE provider_purchase_id='synthetic-rollback') THEN
  RAISE EXCEPTION 'STAGING_ROLLBACK_FAILED';
 END IF;
 IF (SELECT count(*) FROM sahmino_billing_staging.purchase)<>2 THEN
  RAISE EXCEPTION 'STAGING_PURCHASE_COUNT_MISMATCH';
 END IF;
 IF (SELECT count(*) FROM sahmino_billing_staging.audit_event)<>1 THEN
  RAISE EXCEPTION 'STAGING_AUDIT_COUNT_MISMATCH';
 END IF;
 IF (SELECT count(*) FROM sahmino_billing_staging.outbox)<>1 THEN
  RAISE EXCEPTION 'STAGING_OUTBOX_COUNT_MISMATCH';
 END IF;
END
$verify$;
SELECT 'ISOLATED_POSTGRES_SMOKE_PASS' AS test_result;
