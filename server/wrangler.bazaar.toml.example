# Example only. Keep both auth and checkout disabled until provisioning and acceptance pass.
name = "sahmino-billing-bazaar"
main = "worker-api.mjs"
compatibility_date = "2026-06-01"
workers_dev = true

[[d1_databases]]
binding = "SAHAMBAN_DB"
database_name = "REPLACE_WITH_SHARED_SAHMINO_D1_NAME"
database_id = "REPLACE_WITH_SAME_PRODUCTION_D1_ID_IN_BOTH_CONFIGS"

[vars]
BILLING_V2_ENABLED = "false"
SAHMINO_PASSWORD_AUTH_ENABLED = "false"
PILOT_AUTH_ENABLED = "false"
BILLING_STORE = "BAZAAR"
PWA_ORIGIN = "https://REPLACE_WITH_EXACT_PRODUCTION_PWA_ORIGIN"
BAZAAR_PACKAGE_NAME = "REPLACE_WITH_REAL_APPLICATION_ID"
BAZAAR_SKU_MAP = '{"SAHAMBAN_PRO_30D":"REPLACE_BAZAAR_SKU_30D","SAHAMBAN_PRO_60D":"REPLACE_BAZAAR_SKU_60D","SAHAMBAN_PRO_90D":"REPLACE_BAZAAR_SKU_90D","SAHAMBAN_PRO_180D":"REPLACE_BAZAAR_SKU_180D","SAHAMBAN_PRO_365D":"REPLACE_BAZAAR_SKU_365D"}'

# Store only as a Worker secret; never commit the value.
# wrangler secret put AUTH_RATE_LIMIT_SECRET --config wrangler.bazaar.toml
# Bazaar OAuth and RSA secrets remain separate and owner-managed.
