# Example only. DO NOT deploy unchanged.
# A Cloudflare account and private D1 database must be provisioned by the owner.
# Store auth secrets with Wrangler secret bindings (never in this file).
name = "sahamban-pro-pilot"
main = "worker-api.mjs"
compatibility_date = "2026-11-05"
workers_dev = true

[vars]
PWA_ORIGIN = "https://raminhashemi1.github.io"

[[d1_databases]]
binding = "SAHAMBAN_DB"
database_name = "sahamban-pilot"
database_id = "REPLACE_WITH_REAL_D1_DATABASE_ID"
