# Example only. DO NOT deploy unchanged.
# A Cloudflare account and private D1 database must be provisioned by the owner.
# Store auth secrets with Wrangler secret bindings (never in this file).
name = "sahamban-pro-pilot"
main = "worker-api.mjs"
compatibility_date = "2026-06-01"
workers_dev = true

[vars]
PWA_ORIGIN = "https://raminhashemi1.github.io"
# Both flags remain false until OTP cookies, D1 migrations and store sandbox tests pass.
SAHMINO_OTP_ENABLED = "false"
PREPAID_ORDERS_ENABLED = "false"
# Replace each SKU with the exact product ID created in the corresponding publisher console.
MYKET_SKU_30D = "REPLACE_WITH_MYKET_SKU_30D"
MYKET_SKU_60D = "REPLACE_WITH_MYKET_SKU_60D"
MYKET_SKU_90D = "REPLACE_WITH_MYKET_SKU_90D"
MYKET_SKU_180D = "REPLACE_WITH_MYKET_SKU_180D"
MYKET_SKU_365D = "REPLACE_WITH_MYKET_SKU_365D"
BAZAAR_SKU_30D = "REPLACE_WITH_BAZAAR_SKU_30D"
BAZAAR_SKU_60D = "REPLACE_WITH_BAZAAR_SKU_60D"
BAZAAR_SKU_90D = "REPLACE_WITH_BAZAAR_SKU_90D"
BAZAAR_SKU_180D = "REPLACE_WITH_BAZAAR_SKU_180D"
BAZAAR_SKU_365D = "REPLACE_WITH_BAZAAR_SKU_365D"

[[d1_databases]]
binding = "SAHAMBAN_DB"
database_name = "sahamban-pilot"
database_id = "REPLACE_WITH_REAL_D1_DATABASE_ID"
